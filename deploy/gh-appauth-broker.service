[Unit]
Description=gh-appauth broker (GitHub App installation tokens)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=gh-appauth
Group=gh-appauth
# The database holds App private keys; keep everything it creates private.
UMask=0077
StateDirectory=gh-appauth
StateDirectoryMode=0700
ExecStart=/usr/local/bin/gh-appauth-broker serve \
    -db /var/lib/gh-appauth/broker.db \
    -listen 0.0.0.0:8443 \
    -tls self
# Options:
#   -ui-listen 127.0.0.1:8444     admin UI on its own port (or "off")
#   -tls files -tls-cert /etc/gh-appauth/tls/fullchain.pem -tls-key /etc/gh-appauth/tls/privkey.pem
#   -tls off                      plain HTTP (trusted network only)
#   -tls-hosts broker.lan,192.168.1.10
#   -trusted-proxies 127.0.0.1/32 when behind a local reverse proxy
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/gh-appauth
ReadOnlyPaths=-/etc/gh-appauth
# Needed only to listen on a port below 1024 (e.g. 443):
#AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
