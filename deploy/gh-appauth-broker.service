[Unit]
Description=gh-appauth broker (GitHub App installation tokens)
After=network-online.target
Wants=network-online.target

[Service]
# DynamicUser makes the binary's directory read-only for the service, so point
# the database at the StateDirectory instead of the default data/ next to it.
# The admin UI is on loopback so agents, which can reach the API port, can't
# reach the login page. To open it from another machine, change -ui-listen to
# 0.0.0.0:8444 and firewall that port so only your workstation can reach it.
ExecStart=/usr/local/bin/gh-appauth-broker serve -data-dir /var/lib/gh-appauth-broker -listen 0.0.0.0:8443 -ui-listen 127.0.0.1:8444 -tls self
# Options:
#   -ui-listen ""                 admin UI under /ui/ on the API port (or "off")
#   -tls files -tls-cert /etc/gh-appauth/tls/fullchain.pem -tls-key /etc/gh-appauth/tls/privkey.pem
#                                 (the files must be readable by the dynamic user)
#   -tls off                      plain HTTP (trusted network only)
#   -tls-hosts broker.lan,192.168.1.10
#                                 RestrictAddressFamilies blocks netlink, so the
#                                 self-signed cert only covers localhost and the
#                                 hostname unless you list the names/IPs here
#   -trusted-proxies 127.0.0.1/32 when behind a local reverse proxy
#   -tokens-per-minute 240        raise the per-client token rate limit
#                                 (default 60) for clients that run with
#                                 the extension's cache off
# Each flag can also be set with Environment=, e.g.
# Environment=GH_APPAUTH_BROKER_TOKENS_PER_MINUTE=240 (see docs/broker.md).
#
# Single sign-on to the admin UI (docs/broker.md). The client secret arrives as
# a credential, which the dynamic user can read:
#LoadCredential=oidc-secret:/etc/gh-appauth/oidc-secret
# and add to ExecStart (the redirect URL is the address your browser uses for
# the UI, here through an SSH tunnel to port 8444):
#   -oidc-issuer https://id.example.com -oidc-client-id gh-appauth
#   -oidc-client-secret-file %d/oidc-secret
#   -oidc-redirect-url http://localhost:8444/ui/oidc/callback
#   -oidc-allowed-groups broker-admins
ExecReload=/bin/kill -HUP $MAINPID

StateDirectory=gh-appauth-broker
DynamicUser=true

# Filesystem / user isolation
ProtectHome=true
ProtectSystem=strict
UMask=0077

# Devices / kernel
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
ProtectClock=true
ProtectHostname=true

# Process isolation
NoNewPrivileges=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Network
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Capabilities / syscalls
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
